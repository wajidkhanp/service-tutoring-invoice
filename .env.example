NODE_ENV=production
PORT=3001

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://invoice.wajid.dev/auth/google/callback

# Random string, at least 32 chars
SESSION_SECRET=

# Resend — resend.com (replaces Gmail SMTP, works on Railway)
RESEND_API_KEY=
RESEND_FROM_EMAIL=invoices@yourdomain.com
